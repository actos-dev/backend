# ---- Actos backend — ortam değişkenleri ----
# Kullanım: cp .env.example .env  (ve .env'i asla commit'leme)

# --- Postgres ---
POSTGRES_USER=actos
POSTGRES_PASSWORD=actos_dev_password
POSTGRES_DB=actos
# sqlx / uygulama bu URL'i kullanır (host'tan bağlanır, port 3101)
DATABASE_URL=postgres://actos:actos_dev_password@127.0.0.1:3101/actos
DATABASE_MAX_CONNECTIONS=20

# --- Redis ---
REDIS_URL=redis://127.0.0.1:3102

# --- MinIO / S3 ---
MINIO_ROOT_USER=actos_minio
MINIO_ROOT_PASSWORD=actos_minio_dev_password
MINIO_BUCKET=actos-media
S3_ENDPOINT=http://127.0.0.1:3103
S3_REGION=us-east-1
S3_ACCESS_KEY=actos_minio
S3_SECRET_KEY=actos_minio_dev_password
S3_PUBLIC_BASE_URL=http://127.0.0.1:3103/actos-media

# --- API ---
APP_HOST=127.0.0.1
APP_PORT=3100
RUST_LOG=actos_api=debug,tower_http=debug,sqlx=warn,info

# Base62 dış ID'lerin tahmin edilmesini zorlaştıran karıştırma anahtarı.
# Üretimde MUTLAKA rastgele üret: openssl rand -hex 32
ID_OBFUSCATION_KEY=change_me_in_production_0000000000000000000000000000000000000000

# Keyset sayfalama cursor'larını imzalayan HMAC anahtarı (ID_OBFUSCATION_KEY'den
# ayrı, bkz. crates/actos-core/src/config.rs). Üretimde MUTLAKA rastgele üret:
# openssl rand -hex 32
CURSOR_SIGNING_KEY=change_me_in_production_1111111111111111111111111111111111111111

# Kullanılmayan etiketleri toplayan periyodik işin aralığı (saniye).
# 0 = iş hiç başlatılmaz (temizliği dışarıdan cron ile yürütmek isteyen
# dağıtımlar için). Varsayılan 6 saat.
TAG_CLEANUP_INTERVAL_SECS=21600

# hot_score tazeleme işinin aralığı (saniye). 0 = iş hiç başlatılmaz.
# Skor her oyla zaten anında güncelleniyor; bu iş yalnızca zaman terimi
# kaydıkça değerleri tazeliyor. Varsayılan 15 dakika.
HOT_SCORE_INTERVAL_SECS=900

# POST /uploads için gövde üst sınırı (bayt). Varsayılan 8 MB.
MAX_UPLOAD_BYTES=8388608

# Bağlanmamış (yetim) yüklemeleri toplayan işin aralığı (saniye).
# 0 = iş hiç başlatılmaz. Varsayılan 1 saat.
ORPHAN_CLEANUP_INTERVAL_SECS=3600

# Güven kademesi (trust level) tazeleme işinin aralığı (saniye). 0 = iş hiç
# başlatılmaz. Terfi eşikleri saat/gün mertebesinde olduğu için sık koşmanın
# karşılığı yok, ama bir raporun onaylanmasından sonraki düşürmenin makul
# sürede yansıması için de çok seyrek olmamalı. Varsayılan 1 saat.
TRUST_LEVEL_INTERVAL_SECS=3600

# Actor başına TOPLAM depolama kotası (bayt), güven kademesine göre
# (crates/actos-core/src/config.rs::StorageQuotaConfig). MAX_UPLOAD_BYTES
# tek dosyayı sınırlıyor, bu üçlü toplam birikimi sınırlıyor — NOTES.md
# §9.8: "1000 hesapla diski doldurma" senaryosuna karşı. Kademeler artan
# sırada olmalı (0 <= 1 <= 2), aksi halde açılışta hata verir.
STORAGE_QUOTA_TRUST_0_BYTES=52428800
STORAGE_QUOTA_TRUST_1_BYTES=524288000
STORAGE_QUOTA_TRUST_2_BYTES=2147483648
