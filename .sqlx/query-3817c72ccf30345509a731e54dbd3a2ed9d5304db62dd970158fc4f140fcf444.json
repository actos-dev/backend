  "query": "\n                INSERT INTO permissions (actor_id, permission, scope, community_id, granted_by)\n                VALUES ($1, $2, $3, NULL, $4)\n                ON CONFLICT (actor_id, permission) WHERE community_id IS NULL\n                DO UPDATE SET granted_by = EXCLUDED.granted_by, granted_at = now()\n                ",
