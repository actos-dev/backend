  "query": "\n        SELECT votes.content_id, votes.value\n        FROM votes\n        JOIN contents ON contents.id = votes.content_id\n        WHERE votes.actor_id = $1\n          AND votes.content_id = ANY($2::bigint[])\n          AND content_visible_to(contents.community_id, $3::bigint[])\n        ",
