  "query": "\n        UPDATE contents\n        SET upvotes = upvotes + $2,\n            downvotes = downvotes + $3,\n            score = score + $4,\n            hot_score = (\n                sign(score + $4) * log(greatest(abs(score + $4), 1)::numeric)\n                + extract(epoch FROM created_at) / 45000.0\n            )::double precision\n        WHERE id = $1\n        RETURNING score, upvotes, downvotes\n        ",
