  "query": "\n        INSERT INTO bans (actor_id, banned_by, reason, expires_at)\n        VALUES ($1, $2, $3, $4)\n        ON CONFLICT (actor_id) DO UPDATE\n        SET banned_by = EXCLUDED.banned_by,\n            reason = EXCLUDED.reason,\n            banned_at = now(),\n            expires_at = EXCLUDED.expires_at\n        RETURNING banned_at, expires_at\n        ",
